# ==========================================
# TicketOn - Variáveis de Ambiente
# ==========================================

# Configurações do MySQL
MYSQL_ROOT_PASSWORD=root_super_secret_password
MYSQL_DATABASE=eventos_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_secret_password
MYSQL_PORT=3306

# Conexão com o Banco de Dados
# Se estiver rodando via Docker Compose, utilize o host 'db':
DATABASE_URL=mysql+pymysql://app_user:app_secret_password@db:3306/eventos_db

# Se estiver rodando o backend localmente fora do docker (conectando ao MySQL na máquina/Docker exposto):
# DATABASE_URL=mysql+pymysql://app_user:app_secret_password@localhost:3306/eventos_db

# Autenticação e Criptografia
SECRET_KEY=sua_chave_secreta_super_longa_e_aleatoria_para_jwt_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Ticketmaster 
TICKETMASTER_API_KEY=sua_api_key_ticketmaster_aqui
TICKETMASTER_BASE_URL=https://app.ticketmaster.com/discovery/v2

# CORS (Origens permitidas)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_sua_chave_secreta_stripe
STRIPE_WEBHOOK_SECRET=pk_test_sua_chave_publica_webhook_stripe
